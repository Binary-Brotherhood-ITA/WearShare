@page "/clothing"
@using Core
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Clothing</PageTitle>

<h3>Available clothing</h3>

<!-- Søgefelt: Brugeren kan søge efter tøjtype, fx dress, hoodie eller jacket. -->
<div class="col-md-6 mb-3">
    <label for="clothingSearch">Search clothing</label>

    <!-- oninput betyder, at listen opdateres, hver gang brugeren skriver. -->
    <input id="clothingSearch"
           type="search"
           class="form-control"
           placeholder="Search for clothing, e.g. dress or hoodie"
           @bind="searchText"
           @bind:event="oninput" />
</div>

<!-- Filter 1: Brugeren vælger, hvilken type tøj der skal vises. -->
<div class="col-md-3 mb-3">
    <label for="clothingType">Filter by type</label>

    <!-- Binding opdaterer selectedType, når brugeren vælger en type. -->
    <select id="clothingType"
            class="form-select"
            @bind="selectedType">
        <option value="All">All clothing</option>
        <option value="dress">Dress</option>
        <option value="skirt">Skirt</option>
        <option value="pants">Pants</option>
        <option value="shorts">Shorts</option>
        <option value="t-shirt">T-shirt</option>
        <option value="hoodie">Hoodie</option>
        <option value="jacket">Jacket</option>
        <option value="accessories">Accessories</option>
        <option value="other">Other</option>
    </select>
</div>

<!-- Filter 2: Brugeren vælger størrelse. -->
<div class="col-md-3 mb-3">
    <label for="clothingSize">Filter by size</label>

    <select id="clothingSize"
            class="form-select"
            @bind="selectedSize">
        <option value="All">All sizes</option>
        <option value="XS">XS</option>
        <option value="S">S</option>
        <option value="M">M</option>
        <option value="L">L</option>
        <option value="XL">XL</option>
        <option value="XXL">XXL</option>
    </select>
</div>

<!-- Filter 3: Brugeren vælger farve. -->
<div class="col-md-3 mb-3">
    <label for="clothingColor">Filter by color</label>

    <select id="clothingColor"
            class="form-select"
            @bind="selectedColor">
        <option value="All">All colors</option>
        <option value="Black">Black</option>
        <option value="White">White</option>
        <option value="Grey">Grey</option>
        <option value="Beige">Beige</option>
        <option value="Brown">Brown</option>
        <option value="Navy blue">Navy blue</option>
        <option value="Blue">Blue</option>
        <option value="Green">Green</option>
        <option value="Red">Red</option>
        <option value="Pink">Pink</option>
        <option value="Purple">Purple</option>
        <option value="Yellow">Yellow</option>
        <option value="Orange">Orange</option>
        <option value="Other">Other</option>
    </select>
</div>

<!-- Sortering: Påvirker rækkefølgen af det tøj, som søgning og filtre allerede har fundet. -->
<div class="col-md-3 mb-3">
    <label for="clothingSort">Sort by</label>

    <!-- Binding gemmer brugerens valg i selectedSort. -->
    <select id="clothingSort"
            class="form-select"
            @bind="selectedSort">
        <option value="TypeAZ">Type A-Z</option>
        <option value="TypeZA">Type Z-A</option>
        <option value="Size">Size (small to large)</option>
        <option value="Color">Color A-Z</option>
    </select>
</div>

<!-- Nulstiller søgefelt, alle tre filtre og sorteringen. -->
<div class="mb-3">
    <button class="btn btn-secondary"
            @onclick="ClearFilters">
        Clear filters
    </button>
</div>

<!-- Valgt vare: viser brugerens valg uden at ændre MongoDB. -->
@if (selectedClothing != null)
{
    <div class="border p-3 mb-4" role="status" style="background: #f5f1eb;">
        <h4>Valgt tøj: @selectedClothing.Type</h4>
        <p class="mb-2">Størrelse: @selectedClothing.Size · Farve: @selectedClothing.Color</p>
        <p class="mb-2">Du har valgt dette stykke tøj. En egentlig lånefunktion er endnu ikke oprettet.</p>
        <button type="button" class="btn btn-secondary" @onclick="ClearSelection">
            Fjern valg
        </button>
    </div>
}

<!-- Først vises en besked, mens tøjet hentes fra backend. -->
@if (isLoaded == false)
{
    <p>Loading clothing...</p>
}
else if (errorMessage != "")
{
    <!-- Hvis API-kaldet fejlede, viser vi en fejlbesked. -->
    <p>@errorMessage</p>
}
else if (GetFilteredClothing().Count == 0)
{
    <!-- Ingen tilgængelige varer passer til søgningen og de valgte filtre. -->
    <p>No clothing matches your search or filters.</p>
}
else
{
    <!-- Viser det filtrerede tøj i den rækkefølge, brugeren har valgt. -->
    <div class="row">
        @foreach (ClothingItem clothing in GetFilteredClothing())
        {
            <div class="col-md-4 mb-3">
                <div class="border p-3">

                    <!-- Viser kun et billede, hvis tøjet har et billedlink. -->
                    @if (!string.IsNullOrWhiteSpace(clothing.ImgLink))
                    {
                        <img src="@clothing.ImgLink"
                             alt="@clothing.Type"
                             class="img-fluid mb-3"
                             style="width: 100%; height: 250px; object-fit: cover;" />
                    }

                    <!-- Viser de oplysninger, vi har om tøjet. -->
                    <h4>@clothing.Type</h4>
                    <p>Size: @clothing.Size</p>
                    <p>Color: @clothing.Color</p>
                    <p>Owner ID: @clothing.OwnerId</p>
                    <p>Available: @clothing.IsAvailable</p>

                    <!-- Marker varen som valgt i brugerens browser. -->
                    <button type="button"
                            class="btn btn-primary mt-2"
                            @onclick="() => SelectClothing(clothing)">
                        Vælg tøj
                    </button>

                </div>
            </div>
        }
    </div>
}

@code {
    // Listen indeholder kun tøj, der er markeret som tilgængeligt i MongoDB.
    private List<ClothingItem> availableClothing = new();

    // Er false, indtil tøjet er hentet fra backend.
    private bool isLoaded = false;

    // Gemmer en eventuel fejlbesked fra API-kaldet.
    private string errorMessage = "";

    // Søgefeltets indhold. En tom tekst betyder, at søgningen ikke begrænser resultatet.
    private string searchText = "";

    // De tre filtre starter på "All", så alt tilgængeligt tøj kan vises.
    private string selectedType = "All";
    private string selectedSize = "All";
    private string selectedColor = "All";

    // Sortering starter med tøjtype fra A til Z.
    private string selectedSort = "TypeAZ";

    // Holder styr på den vare, som er markeret af brugeren.
    // Denne variabel gemmes kun i Blazor, ikke i databasen.
    private ClothingItem? selectedClothing = null;

    // Blazor kalder denne metode automatisk, når siden åbnes.
    protected override async Task OnInitializedAsync()
    {
        await GetAvailableClothing();
    }

    // Henter tøjet fra API'et og gemmer kun varer, som er tilgængelige.
    private async Task GetAvailableClothing()
    {
        try
        {
            // Sender et GET-kald til backend-controllerens api/clothing-endpoint.
            HttpResponseMessage response =
                await Http.GetAsync("api/clothing");

            // Tjekker, om backend svarede med succes, fx HTTP 200.
            if (response.IsSuccessStatusCode)
            {
                // Omdanner JSON-svaret til ClothingItem-objekter.
                List<ClothingItem>? clothingList =
                    await response.Content.ReadFromJsonAsync<List<ClothingItem>>();

                if (clothingList != null)
                {
                    // Rydder den gamle liste, så varer ikke tilføjes to gange.
                    availableClothing.Clear();

                    foreach (ClothingItem clothing in clothingList)
                    {
                        // Kun tilgængeligt tøj vises på ClothingPage.
                        if (clothing.IsAvailable == true)
                        {
                            availableClothing.Add(clothing);
                        }
                    }
                }
            }
            else
            {
                errorMessage = "Could not load clothing";
            }
        }
        catch (HttpRequestException)
        {
            // Frontend kunne ikke oprette forbindelse til backend.
            errorMessage = "Could not connect to server";
        }

        isLoaded = true;
    }

    // Finder først det tøj, som matcher søgning og filtre, og sorterer derefter listen.
    private List<ClothingItem> GetFilteredClothing()
    {
        // Opretter en ny liste til de varer, der matcher brugerens valg.
        List<ClothingItem> filteredClothing = new();

        // Fjerner mellemrum før og efter søgeteksten.
        string search = searchText.Trim();

        // Gennemgår alle tilgængelige varer.
        foreach (ClothingItem clothing in availableClothing)
        {
            // Søger i tøjets type uden at skelne mellem store og små bogstaver.
            bool searchMatches =
                search == "" ||
                clothing.Type.Contains(search, StringComparison.OrdinalIgnoreCase);

            // "All" betyder, at brugeren ikke filtrerer efter det pågældende felt.
            bool typeMatches =
                selectedType == "All" ||
                string.Equals(clothing.Type, selectedType, StringComparison.OrdinalIgnoreCase);

            bool sizeMatches =
                selectedSize == "All" ||
                string.Equals(clothing.Size, selectedSize, StringComparison.OrdinalIgnoreCase);

            bool colorMatches =
                selectedColor == "All" ||
                string.Equals(clothing.Color, selectedColor, StringComparison.OrdinalIgnoreCase);

            // && betyder OG: Alle fire betingelser skal passe.
            if (searchMatches && typeMatches && sizeMatches && colorMatches)
            {
                filteredClothing.Add(clothing);
            }
        }

        // Sorterer resultatet EFTER filtreringen, så de to funktioner virker sammen.
        if (selectedSort == "TypeAZ")
        {
            // Type fra A til Z (fx dress før hoodie).
            filteredClothing = filteredClothing
                .OrderBy(clothing => clothing.Type, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else if (selectedSort == "TypeZA")
        {
            // Type fra Z til A (fx jacket før dress).
            filteredClothing = filteredClothing
                .OrderByDescending(clothing => clothing.Type, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else if (selectedSort == "Size")
        {
            // Størrelser skal sorteres i rigtig rækkefølge: XS, S, M, L, XL, XXL.
            // Almindelig alfabetisk sortering ville give den forkerte rækkefølge.
            filteredClothing = filteredClothing
                .OrderBy(clothing => GetSizeOrder(clothing.Size))
                .ThenBy(clothing => clothing.Type, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else if (selectedSort == "Color")
        {
            // Farver sorteres alfabetisk fra A til Z.
            filteredClothing = filteredClothing
                .OrderBy(clothing => clothing.Color, StringComparer.OrdinalIgnoreCase)
                .ThenBy(clothing => clothing.Type, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        return filteredClothing;
    }

    // Giver hver størrelse et tal, så de kan sorteres fra lille til stor.
    private int GetSizeOrder(string size)
    {
        // Trim fjerner mellemrum; ToUpperInvariant gør fx "m" og "M" ens.
        switch (size.Trim().ToUpperInvariant())
        {
            case "XS":
                return 1;
            case "S":
                return 2;
            case "M":
                return 3;
            case "L":
                return 4;
            case "XL":
                return 5;
            case "XXL":
                return 6;
            default:
                // Ukendte størrelser placeres efter de kendte størrelser.
                return 100;
        }
    }

    // Brugeren vælger et produkt fra listen.
    // Dette er kun en visuel markering. Et lån kræver et særskilt API og en database-model.
    private void SelectClothing(ClothingItem clothing)
    {
        selectedClothing = clothing;
    }

    // Fjerner den aktuelt valgte vare uden at ændre databasen.
    private void ClearSelection()
    {
        selectedClothing = null;
    }

    // Kaldes, når brugeren trykker på "Clear filters".
    private void ClearFilters()
    {
        // Rydder søgefeltet.
        searchText = "";

        // Nulstiller de tre dropdown-filtre.
        selectedType = "All";
        selectedSize = "All";
        selectedColor = "All";

        // Vender tilbage til standard-sorteringen.
        selectedSort = "TypeAZ";

        // Blazor opdaterer selv visningen efter knapklikket.
    }
}
