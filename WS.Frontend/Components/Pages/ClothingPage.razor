@page "/clothing"
@using Core
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Clothing</PageTitle>

<h3>Available clothing</h3>

<!-- Søgefelt: Brugeren kan søge efter tøjtype, fx dress, hoodie eller jacket. -->
<div class="col-md-6 mb-3">
    <label for="clothingSearch">Search clothing</label>

    <!-- @bind:event="oninput" opdaterer søgningen, hver gang brugeren skriver et tegn. -->
    <input id="clothingSearch"
           type="search"
           class="form-control"
           placeholder="Search for clothing, e.g. dress or hoodie"
           @bind="searchText"
           @bind:event="oninput" />
</div>

<!-- Filter 1: Brugeren vælger, hvilken type tøj der skal vises. -->
<div class="col-md-3 mb-3">
    <label for="clothingType">Filter by type</label>

    <!-- @bind opdaterer selectedType, når brugeren vælger en anden type. -->
    <select id="clothingType"
            class="form-select"
            @bind="selectedType">
        <option value="All">All clothing</option>
        <option value="dress">Dress</option>
        <option value="skirt">Skirt</option>
        <option value="pants">Pants</option>
        <option value="shorts">Shorts</option>
        <option value="t-shirt">T-shirt</option>
        <option value="hoodie">Hoodie</option>
        <option value="jacket">Jacket</option>
        <option value="accessories">Accessories</option>
        <option value="other">Other</option>
    </select>
</div>

<!-- Filter 2: Brugeren vælger, hvilken størrelse der skal vises. -->
<div class="col-md-3 mb-3">
    <label for="clothingSize">Filter by size</label>

    <!-- @bind opdaterer selectedSize automatisk. -->
    <select id="clothingSize"
            class="form-select"
            @bind="selectedSize">
        <option value="All">All sizes</option>
        <option value="XS">XS</option>
        <option value="S">S</option>
        <option value="M">M</option>
        <option value="L">L</option>
        <option value="XL">XL</option>
        <option value="XXL">XXL</option>
    </select>
</div>

<!-- Filter 3: Brugeren vælger, hvilken farve der skal vises. -->
<div class="col-md-3 mb-3">
    <label for="clothingColor">Filter by color</label>

    <!-- @bind opdaterer selectedColor automatisk. -->
    <select id="clothingColor"
            class="form-select"
            @bind="selectedColor">
        <option value="All">All colors</option>
        <option value="Black">Black</option>
        <option value="White">White</option>
        <option value="Grey">Grey</option>
        <option value="Beige">Beige</option>
        <option value="Brown">Brown</option>
        <option value="Navy blue">Navy blue</option>
        <option value="Blue">Blue</option>
        <option value="Green">Green</option>
        <option value="Red">Red</option>
        <option value="Pink">Pink</option>
        <option value="Purple">Purple</option>
        <option value="Yellow">Yellow</option>
        <option value="Orange">Orange</option>
        <option value="Other">Other</option>
    </select>
</div>

<!-- Knappen nulstiller både søgefeltet og de tre dropdown-filtre. -->
<div class="mb-3">
    <button class="btn btn-secondary"
            @onclick="ClearFilters">
        Clear filters
    </button>
</div>

<!-- Først viser vi en besked, mens tøjet hentes fra backend. -->
@if (isLoaded == false)
{
    <p>Loading clothing...</p>
}
else if (errorMessage != "")
{
    <!-- Hvis API-kaldet fejlede, viser vi en fejlbesked. -->
    <p>@errorMessage</p>
}
else if (GetFilteredClothing().Count == 0)
{
    <!-- Ingen tilgængelige varer passer til søgningen og de valgte filtre. -->
    <p>No clothing matches your search or filters.</p>
}
else
{
    <!-- Viser de stykker tøj, som passer til både søgningen og filtrene. -->
    <div class="row">
        @foreach (ClothingItem clothing in GetFilteredClothing())
        {
            <div class="col-md-4 mb-3">
                <div class="border p-3">

                    <!-- Viser kun et billede, hvis tøjet har et billedlink. -->
                    @if (!string.IsNullOrWhiteSpace(clothing.ImgLink))
                    {
                        <img src="@clothing.ImgLink"
                             alt="@clothing.Type"
                             class="img-fluid mb-3"
                             style="width: 100%; height: 250px; object-fit: cover;" />
                    }

                    <!-- Viser de oplysninger, vi har om tøjet. -->
                    <h4>@clothing.Type</h4>
                    <p>Size: @clothing.Size</p>
                    <p>Color: @clothing.Color</p>
                    <p>Owner ID: @clothing.OwnerId</p>
                    <p>Available: @clothing.IsAvailable</p>

                </div>
            </div>
        }
    </div>
}

@code {
    // Listen indeholder kun tøj, der er markeret som tilgængeligt i MongoDB.
    private List<ClothingItem> availableClothing = new();

    // Er false, indtil vi er færdige med at hente tøjet fra backend.
    private bool isLoaded = false;

    // Gemmer en eventuel fejlbesked fra API-kaldet.
    private string errorMessage = "";

    // Søgefeltets indhold. Tom tekst betyder, at søgningen ikke begrænser resultatet.
    private string searchText = "";

    // De tre filtre starter på "All", så alt tilgængeligt tøj vises.
    private string selectedType = "All";
    private string selectedSize = "All";
    private string selectedColor = "All";

    // Blazor kalder denne metode automatisk, når siden åbnes.
    protected override async Task OnInitializedAsync()
    {
        // Henter alt tilgængeligt tøj fra backend.
        await GetAvailableClothing();
    }

    // Henter tøj fra API'et og gemmer kun varer, der er tilgængelige.
    private async Task GetAvailableClothing()
    {
        try
        {
            // Sender et GET-kald til backend-controllerens api/clothing-endpoint.
            HttpResponseMessage response =
                await Http.GetAsync("api/clothing");

            // Tjekker, om backend svarede med en successtatus, fx HTTP 200.
            if (response.IsSuccessStatusCode)
            {
                // Omdanner JSON-svaret til en liste med ClothingItem-objekter.
                List<ClothingItem>? clothingList =
                    await response.Content.ReadFromJsonAsync<List<ClothingItem>>();

                // Undgår fejl, hvis backend ikke sendte en liste tilbage.
                if (clothingList != null)
                {
                    // Rydder listen, så vi ikke tilføjer de samme varer to gange.
                    availableClothing.Clear();

                    // Gennemgår alle varer fra MongoDB.
                    foreach (ClothingItem clothing in clothingList)
                    {
                        // Tilføjer kun varer, som må vises på ClothingPage.
                        if (clothing.IsAvailable == true)
                        {
                            availableClothing.Add(clothing);
                        }
                    }
                }
            }
            else
            {
                // Backend svarede, men API-kaldet lykkedes ikke.
                errorMessage = "Could not load clothing";
            }
        }
        catch (HttpRequestException)
        {
            // Frontend kunne ikke oprette forbindelse til backend.
            errorMessage = "Could not connect to server";
        }

        // Fortæller siden, at indlæsningen er afsluttet.
        isLoaded = true;
    }

    // Finder de varer, som opfylder søgningen og alle tre valgte filtre.
    private List<ClothingItem> GetFilteredClothing()
    {
        // Ny liste til varer, der matcher brugerens valg.
        List<ClothingItem> filteredClothing = new();

        // Fjerner eventuelle mellemrum før og efter den indtastede søgetekst.
        string search = searchText.Trim();

        // Gennemgår alle tilgængelige varer.
        foreach (ClothingItem clothing in availableClothing)
        {
            // Søgningen matcher, hvis feltet er tomt, eller tøjtypen indeholder teksten.
            // Ord som "Dress" og "dress" behandles ens (store/små bogstaver ignoreres).
            bool searchMatches =
                search == "" ||
                clothing.Type.Contains(search, StringComparison.OrdinalIgnoreCase);

            // "All" betyder, at vi ikke filtrerer på netop dette felt.
            // Sammenligningen ignorerer store og små bogstaver i data fra MongoDB.
            bool typeMatches =
                selectedType == "All" ||
                string.Equals(clothing.Type, selectedType, StringComparison.OrdinalIgnoreCase);

            bool sizeMatches =
                selectedSize == "All" ||
                string.Equals(clothing.Size, selectedSize, StringComparison.OrdinalIgnoreCase);

            bool colorMatches =
                selectedColor == "All" ||
                string.Equals(clothing.Color, selectedColor, StringComparison.OrdinalIgnoreCase);

            // && betyder OG: Tøjet skal passe til søgningen OG alle tre filtre.
            if (searchMatches && typeMatches && sizeMatches && colorMatches)
            {
                filteredClothing.Add(clothing);
            }
        }

        // Returnerer kun de varer, der matcher søgningen og filtrene.
        return filteredClothing;
    }

    // Kaldes, når brugeren trykker på knappen "Clear filters".
    private void ClearFilters()
    {
        // Rydder søgeteksten, så brugeren igen kan se alle tøjtyper.
        searchText = "";

        // Nulstiller type, størrelse og farve til deres standardværdi.
        selectedType = "All";
        selectedSize = "All";
        selectedColor = "All";

        // Blazor opdaterer selv visningen efter knapklikket.
        // Derfor behøver vi ikke at kalde StateHasChanged() her.
    }
}
