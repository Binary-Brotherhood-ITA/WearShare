@page "/clothing"
@using Core
@using System.Net.Http.Json
@using Blazored.SessionStorage
@inject HttpClient Http
@inject ISessionStorageService sessionStorage
@inject NavigationManager nav

<PageTitle>Clothing</PageTitle>
@if(loggedIn)
{
    
    <h3>Clothing</h3>
    <!-- FILTRERING -->
    <!-- Søgefelt: Brugeren kan søge efter tøjtype, fx dress, hoodie eller jacket. -->
    <div class="col-md-6 mb-3">
        <label for="clothingSearch">Search clothing</label>
    
        <!-- oninput betyder, at listen opdateres, hver gang brugeren skriver. -->
        <input id="clothingSearch"
               type="search"
               class="form-control"
               placeholder="Search for clothing, e.g. dress or hoodie"
               @bind="searchText"
               @bind:event="oninput" />
    </div>
    
    <!-- Filter 1: Brugeren vælger, hvilken type tøj der skal vises. -->
    <div class="col-md-3 mb-3">
        <label for="clothingType">Filter by type</label>
    
        <!-- Binding opdaterer selectedType, når brugeren vælger en type. -->
        <select id="clothingType"
                class="form-select"
                @bind="selectedType">
            <option value="All">All clothing</option>
            <option value="dress">Dress</option>
            <option value="skirt">Skirt</option>
            <option value="pants">Pants</option>
            <option value="shorts">Shorts</option>
            <option value="t-shirt">T-shirt</option>
            <option value="hoodie">Hoodie</option>
            <option value="jacket">Jacket</option>
            <option value="accessories">Accessories</option>
            <option value="other">Other</option>
        </select>
    </div>
    
    <!-- Filter 2: Brugeren vælger størrelse. -->
    <div class="col-md-3 mb-3">
        <label for="clothingSize">Filter by size</label>
    
        <select id="clothingSize"
                class="form-select"
                @bind="selectedSize">
            <option value="All">All sizes</option>
            <option value="XS">XS</option>
            <option value="S">S</option>
            <option value="M">M</option>
            <option value="L">L</option>
            <option value="XL">XL</option>
            <option value="XXL">XXL</option>
        </select>
    </div>
    
    <!-- Filter 3: Brugeren vælger farve. -->
    <div class="col-md-3 mb-3">
        <label for="clothingColor">Filter by color</label>
    
        <select id="clothingColor"
                class="form-select"
                @bind="selectedColor">
            <option value="All">All colors</option>
            <option value="Black">Black</option>
            <option value="White">White</option>
            <option value="Grey">Grey</option>
            <option value="Beige">Beige</option>
            <option value="Brown">Brown</option>
            <option value="Navy blue">Navy blue</option>
            <option value="Blue">Blue</option>
            <option value="Green">Green</option>
            <option value="Red">Red</option>
            <option value="Pink">Pink</option>
            <option value="Purple">Purple</option>
            <option value="Yellow">Yellow</option>
            <option value="Orange">Orange</option>
            <option value="Other">Other</option>
        </select>
    </div>
    
    <!-- Filter 4: Vis kun tilgængeligt tøj. -->
    <div class="col-md-3 mb-3">
        <label for="availableOnly">Show available only</label>
    
        <div class="available-checkbox">
            <input class="form-check-input"
                   type="checkbox"
                   id="availableOnly"
                   @bind="showAvailableOnly" />
        </div>
    </div>
    
    
    <!-- Sortering: Påvirker rækkefølgen af det tøj, som søgning og filtre allerede har fundet. -->
    <div class="col-md-3 mb-3">
        <label for="clothingSort">Sort by</label>
    
        <!-- Binding gemmer brugerens valg i selectedSort. -->
        <select id="clothingSort"
                class="form-select"
                @bind="selectedSort">
            <option value="TypeAZ">Type A-Z</option>
            <option value="TypeZA">Type Z-A</option>
            <option value="Size">Size (small to large)</option>
            <option value="Color">Color A-Z</option>
        </select>
    </div>
    
    <!-- Nulstiller søgefelt, alle tre filtre og sorteringen. -->
    <div class="mb-3">
        <button class="btn btn-secondary"
                @onclick="ClearFilters">
            Clear filters
        </button>
    </div>
    
    
    <!-- INDHOLD -->
    <!-- Først vises en besked, mens tøjet hentes fra backend. -->
    @if (isLoaded == false)
    {
        <p>Loading clothing...</p>
    }
    else if (errorMessage != "")
    {
        <!-- Hvis API-kaldet fejlede, viser vi en fejlbesked. -->
        <p>@errorMessage</p>
    }
    else if (GetFilteredClothing().Count == 0)
    {
        <!-- Ingen varer passer til filtrering -->
        <p>No clothing matches your search or filters.</p>
    }
    else
    {
        <!-- Viser det filtrerede tøj i den rækkefølge, brugeren har valgt. -->
        <div class="row">
            @foreach (ClothingItem clothing in GetFilteredClothing())
            {
                <div class="col-md-4 mb-3">
                    <div class="border p-3">
    
                        <!-- Viser kun et billede, hvis tøjet har et billedlink. -->
                        @if (!string.IsNullOrWhiteSpace(clothing.ImgLink))
                        {
                            <img src="@clothing.ImgLink"
                                 alt="@clothing.Type"
                                 class="img-fluid mb-3"
                                 style="width: 100%; height: 250px; object-fit: cover;" />
                        }
    
                        <!-- Viser de oplysninger, vi har om tøjet. -->
                        <h4>@clothing.Type</h4>
                        <p>Size: @clothing.Size</p>
                        <p>Color: @clothing.Color</p>
                        <p>Owner: @GetOwnerName(clothing)</p>
                        <p>Status: @if(clothing.IsAvailable) 
                            { 
                                <span class="status-indicator available">
                                    Available
                                    <span class="status-dot"></span>
                                </span>
                            } 
                            else 
                            { 
                                <span class="status-indicator borrowed">
                                    Borrowed
                                    <span class="status-dot"></span>
                                </span>
                            } 
                        </p>
                        <div class="col-md-3 mb-3">
                            <button type="button" class="btn btn-primary mt-2" 
                                disabled="@(!clothing.IsAvailable && clothing.BorrowerId != userId)"
                                @onclick="() => BorrowOrReturn(clothing, (int)userId!)">
                                @if(clothing.IsAvailable)
                                {
                                    <span>Borrow</span>
                                }
                                else
                                {
                                    <span>Return</span>
                                }
                                <span>@borrowReturnMsg</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    // Liste med tøj - siden bruger denne List til at render indhold
    private List<ClothingItem> clothingForDisplay = new();

    // Liste med alle Members fundet i DB
    private List<Member> members = new();

    // Er false, indtil ClothingItems er hentet fra backend
    private bool isLoaded = false;

    // Fortæller om brugeren er logget ind
    private bool loggedIn = false;

    // String til brugerens Member.Name
    private string username = "";

    // brugerens Member.Id
    private int userId = 0;

    // Status besked efter tryk på Borrow / Return
    private string borrowReturnMsg = "";

    // Gemmer en eventuel fejlbesked fra API-kaldet.
    private string errorMessage = "";

    // Søgefeltets indhold. En tom tekst betyder, at søgningen ikke begrænser resultatet.
    private string searchText = "";

    // Filtre starter på "All", så alt tilgængeligt tøj kan vises.
    private string selectedType = "All";
    private string selectedSize = "All";
    private string selectedColor = "All";
    // Filter starter på false: viser alt tøj. Hvis true: viser kun ClothingItem.IsAvailable == true.
    private bool showAvailableOnly = false;
    // Sortering starter med tøjtype fra A til Z.
    private string selectedSort = "TypeAZ";



    /*
     * OnAfterRenderAsync(): 
     * Henter loginstatus og medlems-ID fra sessionStorage. 
     * Hvis brugeren er logget ind og har et ID renders siden. 
     * Ellers ryddes sessionStorage og bruger navigeres til loginPage. 
     */
    // Blazor kalder metoder, når siden åbnes. Kalder GetAllMembers() først, da vi skal bruge resultatet til at vise det indhold, som renders ud fra GetAllClothing().
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Henter loginstatus, username og medlems-ID fra sessionStorage.
            loggedIn = await sessionStorage.GetItemAsync<bool>("userstatus");
            username = await sessionStorage.GetItemAsync<string>("username");
            userId = await sessionStorage.GetItemAsync<int>("userId");

            // Kontrollerer at brugeren er logget ind og har et gyldigt ID.
            if (loggedIn && userId != null && userId > 0)
            {
                await GetAllMembers();
                await GetAllClothing();
            }
            else
            {
                // Fjerner loginoplysninger.
                await sessionStorage.RemoveItemAsync("userstatus");
                await sessionStorage.RemoveItemAsync("username");
                await sessionStorage.RemoveItemAsync("userId");

                // Sender brugeren tilbage til login.
                nav.NavigateTo("/login?message=loginRequired");
            }

            StateHasChanged();
        }
    }

    // Henter tøjet fra API'et og gemmer kun varer, som er tilgængelige.
    private async Task GetAllClothing()
    {
        try
        {
            // Sender et GET-kald til backend-controllerens api/clothing-endpoint.
            HttpResponseMessage response = await Http.GetAsync("api/clothing");

            // Tjekker, om backend svarede med succes, fx HTTP 200.
            if (response.IsSuccessStatusCode)
            {
                // Omdanner JSON-svaret til List af ClothingItem-objekter.
                List<ClothingItem>? clothingList = await response.Content.ReadFromJsonAsync<List<ClothingItem>>();

                // Hvis der er indhold i List fra DB gemmes hele listen i clothingForDisplay
                if (clothingList != null)
                {
                    clothingForDisplay = clothingList;
                }
            }
            else
            {
                errorMessage = "Could not load clothing";
            }
        }
        catch (HttpRequestException)
        {
            // Frontend kunne ikke oprette forbindelse til backend.
            errorMessage = "Could not connect to server";
        }
        isLoaded = true;
    }

    //Henter List med alle members fra DB 
    private async Task GetAllMembers()
    {
        HttpResponseMessage response = await Http.GetAsync("api/members");
        if (response.IsSuccessStatusCode)
        {
            List<Member>? memberList = await response.Content.ReadFromJsonAsync<List<Member>>();
            if (memberList != null)
            {
                members = memberList;
            }
        }
    }

    // Finder match mellem Member.Id og ClothingItem.OwnerId. Hvis match: returnerer member.Name. Ellers returneres fejlbesked string. 
    private string GetOwnerName(ClothingItem clothing)
    {
        foreach(Member member in members)
        {
            if (member.Id == clothing.OwnerId)
            {
                return member.Name;
            }
        }
        return "Owner not found";
    }

    // Opdaterer ClothingItem isAvailable til det modsatte og enten gemmer eller sletter borrowerId
    private async Task BorrowOrReturn(ClothingItem clothing, int userId)
    {
        if(userId <= 0)
        {
            borrowReturnMsg = "Invalid User ID. Try again.";
            return;
        }
        if(clothing.Id <= 0)
        {
            borrowReturnMsg = "Invalid clothing item. Try again.";
            return;
        }
        // Sender PUT-kald til backend.
        HttpResponseMessage response = await Http.PutAsync($"api/clothing/{clothing.Id}/borrowreturn?userId={userId}", null);
        if(response.IsSuccessStatusCode)
        {
            await GetAllMembers();
            await GetAllClothing();
        }
    }


    // Finder først det tøj, som matcher søgning og filtre, og sorterer derefter listen.
    private List<ClothingItem> GetFilteredClothing()
    {
        // Opretter en ny liste til de varer, der matcher brugerens valg.
        List<ClothingItem> filteredClothing = new();

        // Fjerner mellemrum før og efter søgeteksten og gemmer det i search-variabel
        string search = searchText.Trim();

        // Gennemgår alle tilgængelige varer.
        foreach (ClothingItem clothing in clothingForDisplay)
        {
            // Søger i tøjets type uden at skelne mellem store og små bogstaver.
            bool searchMatches = search == "" || clothing.Type.Contains(search, StringComparison.OrdinalIgnoreCase);

            // "All" betyder, at brugeren ikke filtrerer efter det pågældende felt. Hvis der filtreres efter fx Type "Shirt" skal clothingItem.Type være lig Shirt for at blive vist. 
            bool typeMatches = selectedType == "All" || string.Equals(clothing.Type, selectedType, StringComparison.OrdinalIgnoreCase);
            bool sizeMatches = selectedSize == "All" || string.Equals(clothing.Size, selectedSize, StringComparison.OrdinalIgnoreCase);
            bool colorMatches = selectedColor == "All" || string.Equals(clothing.Color, selectedColor, StringComparison.OrdinalIgnoreCase);
            // && betyder OG: Alle fire betingelser skal passe. Fordi ét clothingItem skal matche alle filtrene for at blive vist. 
            // Hvis showAvailableOnly == false, er betingelsen altid sand, og tøjet vises uanset status. Hvis showAvailableOnly == true, skal clothing.IsAvailable også være true før tøjet vises.
            if (searchMatches && typeMatches && sizeMatches && colorMatches && (!showAvailableOnly || clothing.IsAvailable))
            {
                filteredClothing.Add(clothing);
            }
        }

        // Sorterer resultatet EFTER filtreringen, så de to funktioner virker sammen.
        if (selectedSort == "TypeAZ")
        {
            // Type fra A til Z (fx dress før hoodie).
            filteredClothing = filteredClothing
                .OrderBy(clothing => clothing.Type, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else if (selectedSort == "TypeZA")
        {
            // Type fra Z til A (fx jacket før dress).
            filteredClothing = filteredClothing
                .OrderByDescending(clothing => clothing.Type, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else if (selectedSort == "Size")
        {
            // Størrelser skal sorteres i rigtig rækkefølge: XS, S, M, L, XL, XXL.
            // Almindelig alfabetisk sortering ville give den forkerte rækkefølge.
            filteredClothing = filteredClothing
                .OrderBy(clothing => GetSizeOrder(clothing.Size))
                .ThenBy(clothing => clothing.Type, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else if (selectedSort == "Color")
        {
            // Farver sorteres alfabetisk fra A til Z.
            filteredClothing = filteredClothing
                .OrderBy(clothing => clothing.Color, StringComparer.OrdinalIgnoreCase)
                .ThenBy(clothing => clothing.Type, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        return filteredClothing;
    }

    // Giver hver størrelse et tal, så de kan sorteres fra lille til stor.
    private int GetSizeOrder(string size)
    {
        // Trim fjerner mellemrum; ToUpperInvariant gør fx "m" og "M" ens.
        switch (size.Trim().ToUpperInvariant())
        {
            case "XS":
                return 1;
            case "S":
                return 2;
            case "M":
                return 3;
            case "L":
                return 4;
            case "XL":
                return 5;
            case "XXL":
                return 6;
            default:
                // Ukendte størrelser placeres efter de kendte størrelser.
                return 100;
        }
    }

    // Kaldes, når brugeren trykker på "Clear filters".
    private void ClearFilters()
    {
        // Rydder søgefeltet.
        searchText = "";

        // Nulstiller de tre dropdown-filtre.
        selectedType = "All";
        selectedSize = "All";
        selectedColor = "All";
        showAvailableOnly = false;

        // Vender tilbage til standard-sorteringen.
        selectedSort = "TypeAZ";

        // Blazor opdaterer selv visningen efter knapklikket.
    }
}
