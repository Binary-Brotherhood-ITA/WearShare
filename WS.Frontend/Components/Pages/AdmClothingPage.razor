@page "/admClothing"
@using Core
@using Blazored.SessionStorage
@using System.Net.Http.Json
@inject NavigationManager nav
@inject ISessionStorageService sessionStorage
@inject HttpClient Http

<PageTitle>Administrate Clothing</PageTitle>
<h1>Administrate clothing items</h1>


@{
    // Viser en loadingbesked, indtil tøj og medlemsoplysninger er hentet fra backend.
}
@if (!isLoaded)
{
    <p>@loadingCont</p>
}
else if (loggedIn)
{
    <h3>Create clothing</h3>
    <p>Create a clothing item available for other members to borrow</p>

    
        // Formularen bruges til at oprette et nyt ClothingItem.
        // Inputfelterne bindes til newClothing, så brugerens valg gemmes i objektet.
        // OnValidSubmit kalder HandleCreateSubmit, når formularens felter er gyldige.
    
    <section class="ws-create-panel">
        <EditForm Model="@newClothing" OnValidSubmit="HandleCreateSubmit" class="col p-3">
            <DataAnnotationsValidator />

            @{
                // Viser ID på den indloggede bruger, som bliver ejer af tøjet.
                // Readonly betyder, at brugeren ikke selv kan ændre OwnerId.
            }
            <div class="col-md-3 mb-3">
                <label for="OwnerId">Owner ID</label>
                <InputNumber id="OwnerId" @bind-Value="newClothing.OwnerId"
                             class="form-control" readonly />
            </div>

            @{
                // Dropdown-menu med de forskellige tøjtyper fra listen types.
                // Den valgte type gemmes i newClothing.Type.
            }
            <div class="col-md-3 mb-3">
                <label for="Type">Type</label>
                <InputSelect id="Type" @bind-Value="newClothing.Type" class="form-select">
                    <option value="">-- Select type --</option>
                    @foreach (string type in types)
                    {
                        <option value="@type">@type</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => newClothing.Type)" />
            </div>

            @{
                // Dropdown-menu med størrelser fra listen sizes.
                // ValidationMessage viser en fejl, hvis feltet ikke er gyldigt.
            }
            <div class="col-md-3 mb-3">
                <label for="Size">Size</label>
                <InputSelect id="Size" @bind-Value="newClothing.Size" class="form-select">
                    <option value="">-- Select size --</option>
                    @foreach (string size in sizes)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => newClothing.Size)" />
            </div>

            @{
                // Dropdown-menu med farver fra listen colors.
                // Brugerens valg gemmes i newClothing.Color.
            }
            <div class="col-md-3 mb-3">
                <label for="Color">Color</label>
                <InputSelect id="Color" @bind-Value="newClothing.Color" class="form-select">
                    <option value="">-- Select color --</option>
                    @foreach (string color in colors)
                    {
                        <option value="@color">@color</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => newClothing.Color)" />
            </div>

            @{
                // Brugeren indtaster et link til billedet af tøjet.
                // Linket gemmes i ImgLink og bruges senere til at vise billedet.
            }
            <div class="col-md-3 mb-3">
                <label for="ImageLink">Image link</label>
                <InputText id="ImageLink" @bind-Value="newClothing.ImgLink"
                           class="form-control" placeholder="https://example.com/image.jpg" />
                <ValidationMessage For="@(() => newClothing.ImgLink)" />
            </div>

            @{
                // Checkboxen bestemmer, om det nye tøj skal være tilgængeligt for andre.
                // IsAvailable bliver true, når feltet er markeret, og ellers false.
            }
            <div class="col-md-3 mb-3">
                <label for="IsAvailable">Mark as available</label>
                <InputCheckbox id="IsAvailable" @bind-Value="newClothing.IsAvailable"
                               class="form-check-input" />
            </div>

            @{
                // Submit sender formularens oplysninger til HandleCreateSubmit.
                // Clear fields kalder ResetCreateForm og nulstiller formularens felter.
            }
            <div class="col-12 mb-3 ws-form-actions">
                <button type="submit" class="btn btn-primary">Submit</button>
                <button type="button" class="btn btn-secondary" @onclick="ResetCreateForm">Clear fields</button>
            </div>
        </EditForm>
    </section>

    
        // Viser en statusbesked, når brugeren har forsøgt at oprette tøj.
        // Beskeden vises kun, hvis createStatus indeholder tekst.
    
    @if (!string.IsNullOrWhiteSpace(createStatus))
    {
        <p role="status">@createStatus</p>
    }

    
        // Overskrift til listen med den indloggede brugers eget tøj.
        // Opdatér listen henter de nyeste oplysninger fra backend.
    
    <div class="ws-list-heading">
        <div>
            <h3>Administrate my clothing</h3>
            <p>Manage the clothing items you have shared</p>
        </div>
        <button type="button" class="btn btn-secondary" @onclick="RefreshClothing">
            Opdatér listen
        </button>
    </div>

    
        // Viser en fejlbesked, hvis tøjet ikke kunne hentes fra backend.
    
    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <p role="alert">@loadError</p>
    }

    
        // Kontrollerer om brugeren har oprettet noget tøj.
        // allClothing indeholder det tøj, som tilhører den indloggede bruger.
    
    @if (allClothing.Count > 0)
    {
        <section class="ws-clothing-list" aria-label="My clothing">

            @{
                // Gennemgår hvert ClothingItem i listen og viser det på sin egen række.
                // Clothing indeholder oplysningerne om det tøj, der vises i den aktuelle række.
            }
            @foreach (ClothingItem clothing in allClothing)
            {
                <article class="ws-clothing-item" @key="clothing.Id">

                    @{
                        // Viser tøjets billede fra ImgLink.
                        // Hvis tøjet ikke har et billedlink, vises teksten No image.
                    }
                    <div class="ws-clothing-image">
                        @if (!string.IsNullOrWhiteSpace(clothing.ImgLink))
                        {
                            <img src="@clothing.ImgLink" alt="@clothing.Type" />
                        }
                        else
                        {
                            <span>No image</span>
                        }
                    </div>

                    @{
                        // Viser oplysninger om tøjets type, ID, størrelse, farve og tilgængelighed.
                        // IsAvailable bestemmer, om der står Yes eller No.
                    }
                    <div class="ws-clothing-details">
                        <h4>@clothing.Type</h4>
                        <p class="ws-clothing-id">Clothing ID: @clothing.Id</p>
                        <p>Size: @clothing.Size</p>
                        <p>Color: @clothing.Color</p>
                        <p>Available: @(clothing.IsAvailable ? "Yes" : "No")</p>

                        @{
                            // BorrowerId indeholder ID på den person, der har lånt tøjet.
                            // Hvis BorrowerId ikke er null, viser vi navnet på låneren.
                            // GetBorrowerName finder medlemmet ved at sammenligne medlemmernes ID.
                        }
                        @if (clothing.BorrowerId != null)
                        {
                            <p class="ws-borrower">
                                Borrowed by: @GetBorrowerName(clothing.BorrowerId)
                            </p>
                        }
                    </div>

                    @{
                        // Knapperne bruges til at ændre tilgængelighed eller slette tøjet.
                        // HandleAvailabilityChange sender tøjets ID til backend via et PATCH-kald.
                        // Knappen er deaktiveret, hvis BorrowerId ikke er null.
                    }
                    <div class="ws-clothing-actions">
                        <button type="button" class="btn btn-warning"
                                disabled="@(clothing.BorrowerId != null)"
                                @onclick="() => HandleAvailabilityChange(clothing.Id)">
                            @(clothing.IsAvailable ? "Mark as unavailable" : "Mark as available")
                        </button>

                        @{
                            // Delete kalder HandleDeleteSubmit med ID på det valgte tøj.
                            // Metoden sender et DELETE API-kald, som sletter tøjet fra databasen.
                        }
                        <button type="button" class="btn btn-danger"
                                @onclick="() => HandleDeleteSubmit(clothing.Id)">
                            Delete
                        </button>
                    </div>
                </article>
            }
        </section>
    }
    else if (string.IsNullOrWhiteSpace(loadError))
    {
        // Viser en besked, hvis brugeren ikke har noget tøj, og der ikke er en fejl.
        <p>You have no clothing items yet.</p>
    }

    
        // Viser en statusbesked efter ændring af tøjets tilgængelighed.
        // Statusbeskeden vises kun, hvis availabilityStatus indeholder tekst.
    @if (!string.IsNullOrWhiteSpace(availabilityStatus))
    {
        <p role="status">@availabilityStatus</p>
    }

    
        // Viser en statusbesked efter sletning af et stykke tøj.
    
    @if (!string.IsNullOrWhiteSpace(deleteStatus))
    {
        <p role="status">@deleteStatus</p>
    }
}


@code {
    // Holder administrationssiden skjult, indtil login og data er hentet.
    private bool isLoaded = false;
    // Viser om medlemmet er logget ind ifølge sessionStorage.
    private bool loggedIn = false;
    private string loadingCont = "Loading contents. Please wait...";
    // ID på det medlem, som ejer tøjet. Null betyder, at det ikke er hentet endnu.
    private int? ownerId = null;

    // Formularen bruger dette objekt, når medlemmet opretter nyt tøj.
    // Nyt tøj er tilgængeligt som standard.
    private ClothingItem newClothing = new() { IsAvailable = true };
    // Indeholder kun det tøj, som tilhører den indloggede bruger.
    private List<ClothingItem> allClothing = new();
    // Medlemslisten bruges til at finde lånerens navn ud fra BorrowerId.
    private List<Member> members = new();

    // Gemmer beskeder efter oprettelse, sletning og ændring af status.
    private string createStatus = "";
    private string deleteStatus = "";
    private string availabilityStatus = "";
    private string loadError = "";

    // Faste valgmuligheder til formularens dropdownfelter.
    private List<string> types = new()
    {
        "dress", "skirt", "pants", "shorts", "t-shirt",
        "hoodie", "jacket", "accessories", "other"
    };

    private List<string> sizes = new()
    {
        "XS", "S", "M", "L", "XL", "XXL"
    };

    private List<string> colors = new()
    {
        "Black", "White", "Grey", "Beige", "Brown",
        "Navy blue", "Blue", "Green", "Red", "Pink",
        "Purple", "Yellow", "Orange", "Other"
    };

    // Henter loginoplysninger første gang siden er renderet.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Undgår at hente data igen ved hver opdatering af siden.
        if (!firstRender)
        {
            return;
        }

        // sessionStorage kan læses, når Blazor-siden er renderet.
        loggedIn = await sessionStorage.GetItemAsync<bool>("userstatus");
        ownerId = await sessionStorage.GetItemAsync<int?>("userId");

        if (!loggedIn || ownerId == null || ownerId <= 0)
        {
            // Kun et indlogget medlem må oprette og administrere sit tøj.
            nav.NavigateTo("/login?message=loginRequired");
            return;
        }

        // Nyoprettet tøj skal tilhøre den indloggede bruger.
        newClothing.OwnerId = (int)ownerId;

        // Henter medlemsnavne og ejerens tøj fra backend.
        await GetAllMembers();
        await LoadClothing();

        // Gør indholdet synligt og opdaterer Blazor-siden.
        isLoaded = true;
        StateHasChanged();
    }

    // GET api/members: henter medlemmer til at vise navnet på den, som låner.
    private async Task GetAllMembers()
    {
        try
        {
            // API-kaldet går gennem controller og repository til MongoDB.
            HttpResponseMessage response = await Http.GetAsync("api/members");
            if (response.IsSuccessStatusCode)
            {
                List<Member>? memberList =
                    await response.Content.ReadFromJsonAsync<List<Member>>();
                // Hvis der ikke kom en liste tilbage, bruger vi en tom liste.
                members = memberList ?? new List<Member>();
            }
        }
        catch (HttpRequestException)
        {
            // Tøjet kan stadig vises, selv om medlemsnavne ikke kan hentes.
            members = new List<Member>();
        }
    }

    // Henter ejerens tøj fra backend, så listen viser de nyeste oplysninger.
    private async Task LoadClothing()
    {
        // Fjerner en tidligere fejl, før der hentes nye data.
        loadError = "";
        if (ownerId == null || ownerId <= 0)
        {
            loadError = "Owner ID is missing";
            return;
        }

        try
        {
            // Henter kun de varer, der tilhører det indloggede medlem.
            HttpResponseMessage response =
                await Http.GetAsync("api/clothing/member/" + (int)ownerId);

            if (response.IsSuccessStatusCode)
            {
                List<ClothingItem>? clothingList =
                    await response.Content.ReadFromJsonAsync<List<ClothingItem>>();
                // Opdaterer listen, så ændrede eller slettede varer vises korrekt.
                allClothing = clothingList ?? new List<ClothingItem>();
            }
            else
            {
                loadError = "Could not load your clothing";
            }
        }
        catch (HttpRequestException)
        {
            loadError = "Could not connect to server";
        }
    }

    // Finder navnet på den låner, hvis ID er gemt i ClothingItem.BorrowerId.
    private string GetBorrowerName(int? borrowerId)
    {
        // Sammenligner tøjets BorrowerId med medlemmernes ID.
        foreach (Member member in members)
        {
            if (member.Id == borrowerId)
            {
                return member.Name;
            }
        }

        // Bruges hvis låneren ikke længere findes på medlemslisten.
        return "Unknown member";
    }

    // Opdatér listen henter seneste lån og tøj fra backend.
    private async Task RefreshClothing()
    {
        // Henter de nyeste lån og eventuelt nye medlemmer fra backend.
        await GetAllMembers();
        await LoadClothing();
    }

    // Opretter nyt tøj ved at sende formularens ClothingItem til backend.
    private async Task HandleCreateSubmit()
    {
        if (ownerId == null || ownerId <= 0)
        {
            createStatus = "Owner ID is missing";
            return;
        }

        newClothing.OwnerId = (int)ownerId;

        try
        {
            // POST sender det nye tøj som JSON til controlleren.
            HttpResponseMessage response =
                await Http.PostAsJsonAsync("api/clothing", newClothing);

            if (response.IsSuccessStatusCode)
            {
                createStatus = "ADDED CLOTHING: " + newClothing.Type;
                ResetCreateForm();
                createStatus = "Clothing added successfully";
                // Henter listen igen, så tøjet vises efter oprettelsen.
                await LoadClothing();
            }
            else
            {
                createStatus = "The server returned an error";
            }
        }
        catch (HttpRequestException)
        {
            createStatus = "Could not connect to server";
        }
    }

    // Rydder formularens felter, men beholder den aktuelle bruger som ejer.
    private void ResetCreateForm()
    {
        // Nyt tøj starter som ledigt og beholder medlemmets OwnerId.
        newClothing = new ClothingItem { IsAvailable = true };
        if (ownerId != null)
        {
            newClothing.OwnerId = (int)ownerId;
        }
        createStatus = "";
    }

    // Sletter et bestemt stykke tøj, hvis det tilhører den indloggede bruger.
    private async Task HandleDeleteSubmit(int clothingId)
    {
        // Kontrollerer varen mod ejerens egen liste, før DELETE-kaldet sendes.
        bool clothingFound = false;
        foreach (ClothingItem clothing in allClothing)
        {
            if (clothing.Id == clothingId && clothing.OwnerId == ownerId)
            {
                clothingFound = true;
                break;
            }
        }

        if (!clothingFound)
        {
            deleteStatus = "Clothing item not found in your list";
            return;
        }

        try
        {
            // DELETE beder backend slette varen med det valgte ID.
            HttpResponseMessage response =
                await Http.DeleteAsync("api/clothing/" + clothingId);

            if (response.IsSuccessStatusCode)
            {
                deleteStatus = "DELETED CLOTHING: ID " + clothingId;
                await LoadClothing();
            }
            else
            {
                deleteStatus = "The server could not delete the clothing item";
            }
        }
        catch (HttpRequestException)
        {
            deleteStatus = "Could not connect to server";
        }
    }

    // Ændrer om ejerens tøj er tilgængeligt eller utilgængeligt.
    private async Task HandleAvailabilityChange(int clothingId)
    {
        // Finder den valgte vare i ejerens liste.
        ClothingItem? selectedClothing = null;
        foreach (ClothingItem clothing in allClothing)
        {
            if (clothing.Id == clothingId && clothing.OwnerId == ownerId)
            {
                selectedClothing = clothing;
                break;
            }
        }

        if (selectedClothing == null)
        {
            availabilityStatus = "Clothing item not found in your list";
            return;
        }

        // Undgår at markere udlånt tøj som ledigt via denne side.
        if (selectedClothing.BorrowerId != null)
        {
            availabilityStatus = "Borrowed clothing cannot be marked as available";
            return;
        }

        try
        {
            // PATCH beder backend skifte IsAvailable for den valgte vare.
            HttpResponseMessage response =
                await Http.PatchAsync("api/clothing/" + clothingId + "/availability", null);

            if (response.IsSuccessStatusCode)
            {
                availabilityStatus = "Clothing availability updated";
                await LoadClothing();
            }
            else
            {
                availabilityStatus = "Could not update clothing availability";
            }
        }
        catch (HttpRequestException)
        {
            availabilityStatus = "Could not connect to server";
        }
    }
}
