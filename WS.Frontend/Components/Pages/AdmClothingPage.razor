@page "/admClothing"
@using Core
@using Blazored.SessionStorage
@using System.Net.Http.Json
@inject NavigationManager nav
@inject ISessionStorageService sessionStorage
@inject HttpClient Http

<PageTitle>Administrate Clothing</PageTitle>
<h1>Administrate clothing items</h1>

@if (isLoaded && loggedIn)
{
    <h3>Create clothing</h3>
    <p>Create a clothing item available for other members to borrow</p>

    <EditForm Model="@newClothing" OnValidSubmit="@HandleCreateSubmit" class="col p-3">
        <DataAnnotationsValidator />

        <!-- CLOTHING.OWNERID -->
        <div class="col-md-3 mb-3">
            <!-- Viser ID på medlemmet, der ejer tøjet -->
            <label for="OwnerId">Owner ID</label>
            <InputNumber @bind-Value="newClothing.OwnerId"
                         id="OwnerId"
                         class="form-control" readonly />
        </div>

        <!-- CLOTHING.TYPE -->
        <div class="col-md-3 mb-3">
            <label for="Type">Type</label>
            <InputSelect @bind-Value="newClothing.Type" class="form-select" style="width: 200px;">
                <option value="">-- Select type --</option>
                @foreach (string type in types)
                {
                    <option value="@type">@type</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => newClothing.Type)" />
        </div>

        <!-- CLOTHING.SIZE -->
        <div class="col-md-3 mb-3">
            <label for="Size">Size</label>
            <InputSelect @bind-Value="newClothing.Size" class="form-select" style="width: 200px;">
                <option value="">-- Select Size --</option>
                @foreach (string size in sizes)
                {
                    <option value="@size">@size</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => newClothing.Size)" />
        </div>

        <!-- CLOTHING.COLOR -->
        <div class="col-md-3 mb-3">
            <label for="Color">Color</label>
            <InputSelect @bind-Value="newClothing.Color" class="form-select" style="width: 200px;">
                <option value="">-- Select color --</option>
                @foreach (string color in colors)
                {
                    <option value="@color">@color</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => newClothing.Color)" />
        </div>

        <!-- CLOTHING.IMGLINK -->
        <div class="col-md-3 mb-3">
            <label for="ImageLink">Image link</label>
            <InputText @bind-Value="newClothing.ImgLink"
                       id="ImageLink"
                       class="form-control"
                       placeholder="https://example.com/image.jpg" />
            <ValidationMessage For="@(() => newClothing.ImgLink)" />
        </div>

        <!-- CLOTHING.ISAVAILABLE -->
        <div class="col-md-3 mb-3">
            <label for="IsAvailable">Mark as available</label>
            <InputCheckbox @bind-Value="newClothing.IsAvailable"
                           id="IsAvailable"
                           class="form-check-input" />
        </div>

        <div class="col-12 mb-3">
            <button type="submit" class="btn btn-primary">
                Submit
            </button>
        </div>

        <div class="col-12 mb-3">
            <button type="button" class="btn btn-primary" @onclick="ResetCreateForm">
                Clear fields
            </button>
        </div>
    </EditForm>

    <span>@createStatus</span>

    <h3>Administrate my clothing</h3>
    <p>Delete a clothing item</p>

    <!-- Viser kun tøj, som backend har fundet ved hjælp af den indloggede brugers OwnerId -->
    @if (allClothing != null && allClothing.Count > 0)
    {
        <!-- Gennemgår hvert stykke tøj i listen -->
        @foreach (ClothingItem clothing in allClothing)
        {
            <div class="border p-3 mb-3">
                <!-- Viser oplysninger om det enkelte stykke tøj -->
                <p>Clothing ID: @clothing.Id</p>
                <p>Type: @clothing.Type</p>
                <p>Size: @clothing.Size</p>
                <p>Color: @clothing.Color</p>
                <p>Available: @(clothing.IsAvailable ? "Yes" : "No")</p>

                <!-- Viser varens billede, når der er angivet et billedlink. -->
                @if (!string.IsNullOrWhiteSpace(clothing.ImgLink))
                {
                    <img src="@clothing.ImgLink"
                         alt="@clothing.Type"
                         class="img-fluid mb-3"
                         style="width: 100%; max-height: 180px; object-fit: cover;" />
                }

                <!-- PATCH: skifter status mellem tilgængelig og utilgængelig. -->
                <button type="button"
                        class="btn btn-warning me-2"
                        @onclick="() => HandleAvailabilityChange(clothing.Id)">
                    @(clothing.IsAvailable ? "Mark as unavailable" : "Mark as available")
                </button>

                <!-- Sender netop dette tøjs ID til slette-metoden ved klik -->
                <button type="button"
                        class="btn btn-danger"
                        @onclick="() => HandleDeleteSubmit(clothing.Id)">
                    Delete
                </button>
            </div>
        }
    }
    else
    {
        <!-- Vises, hvis den indloggede bruger ikke har oprettet noget tøj endnu -->
        <p>You have no clothing items yet.</p>
    }

    <!-- Statusbeskeder efter ændring af tilgængelighed og sletning. -->
    @if (!string.IsNullOrWhiteSpace(availabilityStatus))
    {
        <p role="status">@availabilityStatus</p>
    }
    @if (!string.IsNullOrWhiteSpace(deleteStatus))
    {
        <p role="status">@deleteStatus</p>
    }
}
else
{
    <span>@loadingCont</span>
}

@code {
    // Starter med false, fordi tøjet endnu ikke er hentet
    private bool isLoaded = false;

    // Besked som vises under indlæsning
    private string loadingCont = "Loading contents. Please wait...";

    // Fortæller om brugeren er logget ind
    private bool loggedIn = false;

    // Gemmer ID på den bruger, der ejer tøjet
    private int? ownerId = null;

    // Objekt som bruges til at oprette nyt tøj
    ClothingItem newClothing = new() { IsAvailable = true };

    // Liste med forskellige typer tøj
    private List<string> types = new()
    {
        "dress", "skirt", "pants", "shorts", "t-shirt",
        "hoodie", "jacket", "accessories", "other"
    };

    // Liste med størrelser
    private List<string> sizes = new()
    {
        "XS", "S", "M", "L", "XL", "XXL"
    };

    // Liste med farver
    private List<string> colors = new()
    {
        "Black", "White", "Grey", "Beige", "Brown",
        "Navy blue", "Blue", "Green", "Red", "Pink",
        "Purple", "Yellow", "Orange", "Other"
    };

    // Statusbesked efter oprettelse af tøj
    private string createStatus = "";

    // Statusbesked efter sletning af tøj
    private string deleteStatus = "";

    // Statusbesked efter ændring af tilgængelighed.
    private string availabilityStatus = "";

    // Liste med tøj fra databasen
    private List<ClothingItem>? allClothing = new();

    /*
     * OnAfterRenderAsync():
     * Henter loginstatus og medlems-ID fra sessionStorage.
     * Hvis brugeren er logget ind og har et ID,
     * sættes OwnerId på det nye tøj.
     * Ellers sendes brugeren til login.
     */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Henter oplysninger fra sessionStorage
            loggedIn = await sessionStorage.GetItemAsync<bool>("userstatus");
            ownerId = await sessionStorage.GetItemAsync<int?>("userId");

            // Kontrollerer at brugeren er logget ind og har et gyldigt ID
            if (loggedIn && ownerId != null && ownerId > 0)
            {
                // Giver tøjet samme ID som den indloggede ejer
                newClothing.OwnerId = (int)ownerId;

                // Henter kun tøjet som tilhører den indloggede bruger
                allClothing = await GetClothingByOwnerId((int)ownerId);
            }
            else
            {
                // Fjerner loginoplysninger
                await sessionStorage.RemoveItemAsync("userstatus");
                await sessionStorage.RemoveItemAsync("username");
                await sessionStorage.RemoveItemAsync("userId");

                // Sender brugeren tilbage til login
                nav.NavigateTo("/login?message=loginRequired");
            }

            StateHasChanged();
        }
    }

    /*
     * GetAllClothing():
     * Henter alt tøj gennem backend API.
     * Vi bruger den ikke på denne side lige nu, fordi vi kun vil vise ejerens eget tøj.
     * Metoden beholdes til senere, hvis vi får brug for at vise alt tøj.
     */
    private async Task<List<ClothingItem>?> GetAllClothing()
    {
        // Sender et GET API-kald til vores backend
        HttpResponseMessage response =
            await Http.GetAsync("api/clothing");

        // Tjekker om backend har svaret med succes
        if (response.IsSuccessStatusCode)
        {
            // Læser JSON-svaret fra backend
            // Laver JSON om til en liste med ClothingItem-objekter
            List<ClothingItem>? clothingList =
                await response.Content.ReadFromJsonAsync<List<ClothingItem>>();

            // Tjekker om vi har modtaget en liste
            if (clothingList != null)
            {
                // Fortæller siden at indholdet er indlæst
                isLoaded = true;

                // Returnerer listen med alt tøj
                return clothingList;
            }
        }

        // Hvis API-kaldet ikke lykkedes, viser vi en fejlbesked
        isLoaded = false;
        loadingCont = "Could not load clothing from server";

        // Returnerer en tom liste
        return new List<ClothingItem>();
    }
    
    
    /*
     * GetClothingByOwnerId():
     * Henter kun det tøj, der har den indloggede brugers ID som OwnerId.
     * Bruges ved indlæsning, oprettelse og sletning.
     */
    private async Task<List<ClothingItem>?> GetClothingByOwnerId(int id)
    {
        // Sender et GET API-kald til backend med ejerens ID
        // Eksempel: api/clothing/member/4
        HttpResponseMessage response =
            await Http.GetAsync("api/clothing/member/" + id);

        // Tjekker om backend har svaret med succes
        if (response.IsSuccessStatusCode)
        {
            // Læser JSON-svaret og laver det om til en liste med tøj
            List<ClothingItem>? clothingList =
                await response.Content.ReadFromJsonAsync<List<ClothingItem>>();

            // Tjekker om vi har modtaget listen
            if (clothingList != null)
            {
                // Fortæller siden at indholdet er indlæst
                isLoaded = true;

                // Returnerer medlemmets eget tøj
                return clothingList;
            }
        }

        // Viser en fejl hvis API-kaldet ikke lykkedes
        isLoaded = false;
        loadingCont = "Could not load your clothing";

        // Returnerer en tom liste
        return new List<ClothingItem>();
    }


    /*
     * HandleCreateSubmit():
     * Skal sende nyt tøj til backend gennem et POST API-kald.
     * Backend skal gemme tøjet i MongoDB.
     */
    private async Task HandleCreateSubmit()
    {
        // Kontrollerer at vi har et gyldigt medlems-ID
        if (ownerId == null || ownerId <= 0)
        {
            createStatus = "Owner ID is missing";
            return;
        }

        // Giver tøjet samme OwnerId som den indloggede bruger
        newClothing.OwnerId = (int)ownerId;

        // Sender tøjet til backend gennem et POST API-kald
        HttpResponseMessage response =
            await Http.PostAsJsonAsync("api/clothing", newClothing);

        // Tjekker om backend har oprettet tøjet
        if (response.IsSuccessStatusCode)
        {
            // Viser en bekræftelse på hjemmesiden
            createStatus = $"ADDED CLOTHING: Type: {newClothing.Type}, Size: {newClothing.Size}, Color: {newClothing.Color}";

            // Nulstiller formularen
            newClothing = new ClothingItem { IsAvailable = true };

            // Beholder den indloggede brugers ID som ejer af det næste stykke tøj
            newClothing.OwnerId = (int)ownerId;

            // Opdaterer listen med den indloggede brugers tøj
            allClothing = await GetClothingByOwnerId((int)ownerId);
        }
        else
        {
            // Viser en fejl hvis backend ikke kunne oprette tøjet
            createStatus = "The server returned an error";
        }
    }


    /*
     * ResetCreateForm():
     * Nulstiller formularen.
     * OwnerId beholdes, da ejeren stadig er den samme.
     */
    private void ResetCreateForm()
    {
        // Opretter et nyt tomt ClothingItem
        newClothing = new ClothingItem { IsAvailable = true };

        // Beholder ID på den indloggede ejer
        if (ownerId != null)
        {
            newClothing.OwnerId = (int)ownerId;
        }

        // Fjerner den gamle statusbesked
        createStatus = "";
    }

    /*
     * HandleDeleteSubmit():
     * Får tøjets ID fra Delete-knappen og sender et DELETE-kald til backend.
     * Hvis sletningen lykkes, opdaterer vi listen med den indloggede brugers tøj.
     */
    private async Task HandleDeleteSubmit(int clothingId)
    {
        // Kontrollerer at brugeren er logget ind med et gyldigt ID
        if (ownerId == null || ownerId <= 0)
        {
            deleteStatus = "Owner ID is missing";
            return;
        }

        // Kontrollerer at tøjet findes i den liste, som tilhører brugeren
        // Det undgår, at vi ved en fejl sender et andet tøjs ID fra denne side
        bool clothingFound = false;

        if (allClothing != null)
        {
            foreach (ClothingItem clothing in allClothing)
            {
                if (clothing.Id == clothingId && clothing.OwnerId == ownerId)
                {
                    clothingFound = true;
                    break;
                }
            }
        }

        // Stopper, hvis tøjet ikke findes på brugerens egen liste
        if (clothingFound == false)
        {
            deleteStatus = "Clothing item not found in your list";
            return;
        }

        // Sender et DELETE-kald til backend med tøjets ID
        // Eksempel: DELETE api/clothing/1
        HttpResponseMessage response =
            await Http.DeleteAsync("api/clothing/" + clothingId);

        // Tjekker om backend kunne slette tøjet
        if (response.IsSuccessStatusCode)
        {
            // Viser en besked om det slettede tøj
            deleteStatus = "DELETED CLOTHING: ID " + clothingId;

            // Henter den opdaterede liste med den indloggede brugers tøj
            // Så det slettede tøj forsvinder fra skærmen
            allClothing = await GetClothingByOwnerId((int)ownerId);
        }
        else
        {
            // Viser en fejl, hvis API-kaldet ikke lykkedes
            deleteStatus = "The server could not delete the clothing item";
        }
    }

    /*
     * HandleAvailabilityChange():
     * Ændrer IsAvailable for et af den indloggede brugers tøjstykker.
     * Backend skifter true til false eller false til true.
     */
    private async Task HandleAvailabilityChange(int clothingId)
    {
        // Stop hvis brugeren ikke har et gyldigt medlems-ID.
        if (ownerId == null || ownerId <= 0)
        {
            availabilityStatus = "Owner ID is missing";
            return;
        }

        // Tjekker, at tøjet er i brugerens egen viste liste.
        bool clothingFound = false;
        if (allClothing != null)
        {
            foreach (ClothingItem clothing in allClothing)
            {
                if (clothing.Id == clothingId && clothing.OwnerId == ownerId)
                {
                    clothingFound = true;
                    break;
                }
            }
        }

        if (clothingFound == false)
        {
            availabilityStatus = "Clothing item not found in your list";
            return;
        }

        try
        {
            // PATCH: api/clothing/4/availability
            HttpResponseMessage response =
                await Http.PatchAsync("api/clothing/" + clothingId + "/availability", null);

            if (response.IsSuccessStatusCode)
            {
                availabilityStatus = "Clothing availability updated";

                // Henter listen igen, så brugeren ser den nye status.
                allClothing = await GetClothingByOwnerId((int)ownerId);
            }
            else
            {
                availabilityStatus = "Could not update clothing availability";
            }
        }
        catch (HttpRequestException)
        {
            availabilityStatus = "Could not connect to server";
        }
    }

}
