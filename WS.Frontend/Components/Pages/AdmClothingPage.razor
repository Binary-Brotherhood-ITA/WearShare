
@page "/admClothing"
@using Core
@using Blazored.SessionStorage
@inject NavigationManager nav
@inject ISessionStorageService sessionStorage

<PageTitle>Administrate Clothing</PageTitle>
<h1>Administrate clothing items</h1>

@if (isLoaded && loggedIn)
{
    <h3>Create clothing</h3>
    <p>Create a clothing item available for other members to borrow</p>

    <EditForm Model="@newClothing" OnValidSubmit="@HandleCreateSubmit" class="col p-3">
        <DataAnnotationsValidator />

        <!-- CLOTHING.OWNERID -->
        <div class="col-md-3 mb-3">
            <!-- Viser ID på medlemmet, der ejer tøjet -->
            <label for="OwnerId">Owner ID</label>
            <InputNumber @bind-Value="newClothing.OwnerId"
                         id="OwnerId"
                         class="form-control" readonly />
        </div>

        <!-- CLOTHING.TYPE -->
        <div class="col-md-3 mb-3">
            <label for="Type">Type</label>
            <InputSelect @bind-Value="newClothing.Type" class="form-select" style="width: 200px;">
                <option value="">-- Select type --</option>
                @foreach (string type in types)
                {
                    <option value="@type">@type</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => newClothing.Type)" />
        </div>

        <!-- CLOTHING.SIZE -->
        <div class="col-md-3 mb-3">
            <label for="Size">Size</label>
            <InputSelect @bind-Value="newClothing.Size" class="form-select" style="width: 200px;">
                <option value="">-- Select Size --</option>
                @foreach (string size in sizes)
                {
                    <option value="@size">@size</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => newClothing.Size)" />
        </div>

        <!-- CLOTHING.COLOR -->
        <div class="col-md-3 mb-3">
            <label for="Color">Color</label>
            <InputSelect @bind-Value="newClothing.Color" class="form-select" style="width: 200px;">
                <option value="">-- Select color --</option>
                @foreach (string color in colors)
                {
                    <option value="@color">@color</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => newClothing.Color)" />
        </div>

        <!-- CLOTHING.IMGLINK -->
        <div class="col-md-3 mb-3">
            <label for="ImageLink">Image link</label>
            <InputText @bind-Value="newClothing.ImgLink"
                       id="ImageLink"
                       class="form-control"
                       placeholder="https://example.com/image.jpg" />
            <ValidationMessage For="@(() => newClothing.ImgLink)" />
        </div>

        <!-- CLOTHING.ISAVAILABLE -->
        <div class="col-md-3 mb-3">
            <label for="IsAvailable">Mark as available</label>
            <InputCheckbox @bind-Value="newClothing.IsAvailable"
                           id="IsAvailable"
                           class="form-check-input" />
        </div>

        <div class="col-12 mb-3">
            <button type="submit" class="btn btn-primary">
                Submit
            </button>
        </div>

        <div class="col-12 mb-3">
            <button type="button" class="btn btn-primary" @onclick="ResetCreateForm">
                Clear fields
            </button>
        </div>
    </EditForm>

    <span>@createStatus</span>

    <h3>Administrate my clothing</h3>
    <p>Delete a clothing item</p>

    <!-- TODO: Vis medlemmets tøj ved hjælp af OwnerId -->

    <span>@deleteStatus</span>
}
else
{
    <span>@loadingCont</span>
}

@code {
    // Fortæller om indholdet er indlæst
    private bool isLoaded = true;

    // Besked som vises under indlæsning
    private string loadingCont = "Loading contents. Please wait...";

    // Fortæller om brugeren er logget ind
    private bool loggedIn = false;

    // Gemmer ID på den bruger, der ejer tøjet
    private int? ownerId = null;

    // Objekt som bruges til at oprette nyt tøj
    ClothingItem newClothing = new();

    // Liste med forskellige typer tøj
    private List<string> types = new()
    {
        "dress", "skirt", "pants", "shorts", "t-shirt",
        "hoodie", "jacket", "accessories", "other"
    };

    // Liste med størrelser
    private List<string> sizes = new()
    {
        "XS", "S", "M", "L", "XL", "XXL"
    };

    // Liste med farver
    private List<string> colors = new()
    {
        "Black", "White", "Grey", "Beige", "Brown",
        "Navy blue", "Blue", "Green", "Red", "Pink",
        "Purple", "Yellow", "Orange", "Other"
    };

    // Statusbesked efter oprettelse af tøj
    private string createStatus = "";

    // Objekt som bruges ved sletning af tøj
    ClothingItem deleteClothing = new();

    // Statusbesked efter sletning af tøj
    private string deleteStatus = "";

    // Liste med tøj fra databasen
    private List<ClothingItem>? allClothing = new();

    /*
     * OnAfterRenderAsync():
     * Henter loginstatus og medlems-ID fra sessionStorage.
     * Hvis brugeren er logget ind og har et ID,
     * sættes OwnerId på det nye tøj.
     * Ellers sendes brugeren til login.
     */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Henter oplysninger fra sessionStorage
            loggedIn = await sessionStorage.GetItemAsync<bool>("userstatus");
            ownerId = await sessionStorage.GetItemAsync<int?>("userId");

            // Kontrollerer at brugeren er logget ind og har et gyldigt ID
            if (loggedIn && ownerId != null && ownerId > 0)
            {
                // Giver tøjet samme ID som den indloggede ejer
                newClothing.OwnerId = (int)ownerId;

                // Henter listen med tøj
                allClothing = await GetAllClothing();
            }
            else
            {
                // Fjerner loginoplysninger
                await sessionStorage.RemoveItemAsync("userstatus");
                await sessionStorage.RemoveItemAsync("username");
                await sessionStorage.RemoveItemAsync("userId");

                // Sender brugeren tilbage til login
                nav.NavigateTo("/login?message=loginRequired");
            }

            StateHasChanged();
        }
    }

    /*
     * GetAllClothing():
     * Skal hente en liste med tøj gennem backend API.
     * API-kaldet tilføjes, når ClothingController er klar.
     */
    private async Task<List<ClothingItem>?> GetAllClothing()
    {
        // Midlertidig tom liste
        List<ClothingItem>? clothingList = new();

        // TODO: Hent alt tøj gennem GET /api/clothing

        return clothingList;
    }

    /*
     * HandleCreateSubmit():
     * Skal sende nyt tøj til backend gennem et POST API-kald.
     * Backend skal gemme tøjet i MongoDB.
     */
    private async Task HandleCreateSubmit()
    {
        // TODO: Kald POST /api/clothing med newClothing

        // Oprettelse er endnu ikke forbundet til API'et
        createStatus = "Clothing API is not connected yet.";

        /*
         * Når API'et er klar:
         *
         * 1. Send newClothing til backend
         * 2. Kontrollér om oprettelsen lykkedes
         * 3. Vis en bekræftelse med newClothing.OwnerId
         * 4. Nulstil formularen
         * 5. Hent den opdaterede liste med tøj
         */
    }

    /*
     * ResetCreateForm():
     * Nulstiller formularen.
     * OwnerId beholdes, da ejeren stadig er den samme.
     */
    private void ResetCreateForm()
    {
        // Opretter et nyt tomt ClothingItem
        newClothing = new ClothingItem();

        // Beholder ID på den indloggede ejer
        if (ownerId != null)
        {
            newClothing.OwnerId = (int)ownerId;
        }

        // Fjerner den gamle statusbesked
        createStatus = "";
    }

    /*
     * HandleDeleteSubmit():
     * Skal senere slette et stykke tøj gennem backend API.
     */
    private async Task HandleDeleteSubmit()
    {
        // TODO: Kald DELETE API med deleteClothing.Id

        // Sletning er endnu ikke forbundet til API'et
        deleteStatus = "Clothing delete API is not connected yet.";

        /*
         * Når API'et er klar:
         *
         * 1. Send tøjets ID til backend
         * 2. Kontrollér om sletningen lykkedes
         * 3. Vis en bekræftelse
         * 4. Opdater listen med tøj
         */
    }

    /*
     * ResetDeleteForm():
     * Nulstiller objektet, der bruges til sletning.
     */
    private void ResetDeleteForm()
    {
        // Opretter et nyt tomt ClothingItem
        deleteClothing = new ClothingItem();

        // Fjerner statusbeskeden
        deleteStatus = "";
    }
}
