@page "/login"
@using Microsoft.AspNetCore.Components
@using Core
@using Blazored.SessionStorage
@inject NavigationManager nav
@inject ISessionStorageService sessionStorage
@inject HttpClient Http
<PageTitle>Log ind</PageTitle>

<h3>Log ind</h3>

<div class="login-container">

    
    <div style="text-align: center">
        @if(!loggedIn)
        {
            <InputText @bind-Value="memberName"
               class="form-control mb-2"
               placeholder="Indtast dit navn" />
            <button class="btn btn-primary" @onclick="OnClickLogin">Login</button>
        }
        else
        {
            <span>Logget ind som: @username</span>
            <button class="btn btn-primary" @onclick="OnClickLogout">Logout</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorText))
    {
        <div class="error-message">
            <span class="error-icon">⚠️</span>
            <span class="error-text">@errorText</span>
        </div>
    }
</div>


@code {
    [SupplyParameterFromQuery(Name = "message")]
    public string? Message { get; set; } // query-parameter læses fra URL'en

    private string? memberName = ""; // member.Name - bruger indtaster sit navn og InputText bindes hertil.
    string errorText = ""; // Bruges til at vise errortext hvis relevant
    bool loggedIn = false; // Fortæller om bruger er logget ind ifølge sessionStorage
    string username = ""; // Henter navn på den som er logget ind

    /* OnAfterRenderAsync():
     * Efter Blazor har rendered siden, hentes loggedIn fra sessionStorage
     * Hvis message fra URL == loginRequired tilpasses errorText
     */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            loggedIn = await sessionStorage.GetItemAsync<bool>("userstatus");
            username = await sessionStorage.GetItemAsync<string>("username");
                if(Message == "loginRequired")
                {
                    errorText = "You need to login to add or edit clothing items";
                }
            StateHasChanged();
        }
    }

    
    
    private async Task OnClickLogin()
    {
        // Tjekker om brugeren har skrevet et navn
        if (string.IsNullOrWhiteSpace(memberName))
        {
            // Viser en fejl, hvis navnet er tomt
            errorText = "Please enter your name";
            return;
        }

        // Sender et GET API-kald til backend med navnet
        // Eksempel: api/members/Amina
        HttpResponseMessage response =
            await Http.GetAsync("api/members/" + memberName);

        // Tjekker om backend har fundet medlemmet
        if (response.IsSuccessStatusCode)
        {
            // Henter medlemmet fra API-svaret
            // JSON bliver lavet om til et Member-objekt
            Member? member =
                await response.Content.ReadFromJsonAsync<Member>();

            // Tjekker at medlemmet findes og har et gyldigt ID
            if (member != null && member.Id > 0)
            {
                // Brugeren er nu logget ind
                loggedIn = true;

                // Fjerner tidligere fejlbeskeder
                errorText = "";

                // Gemmer at brugeren er logget ind
                await sessionStorage.SetItemAsync("userstatus", true);

                // Gemmer medlemmets navn
                await sessionStorage.SetItemAsync("username", member.Name);

                // Gemmer medlemmets ID
                await sessionStorage.SetItemAsync("userId", member.Id);

                // Sender brugeren til forsiden
                nav.NavigateTo("/", true);
            }
            else
            {
                // Viser fejl hvis medlemmet mangler et gyldigt ID
                errorText = "Member has no valid ID";
            }
        }
        else
        {
            // Viser fejl hvis medlemmet ikke blev fundet
            errorText = "Member not found";
        }
    }
    

    private async Task OnClickLogout()
    {
        // Logger brugeren ud
        loggedIn = false;
        memberName = null;

        // Fjerner loginoplysninger
        await sessionStorage.RemoveItemAsync("userstatus");
        await sessionStorage.RemoveItemAsync("username");
        await sessionStorage.RemoveItemAsync("userId");

        // Genindlæser login-siden
        nav.NavigateTo("/login", true);
    }


}