@using Blazored.SessionStorage
@inject ISessionStorageService sessionStorage
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            @if(loggedIn && !string.IsNullOrEmpty(username))
            {
                <div class="d-flex align-items-center gap-3">
                    <span>
                        Logget ind som: @username
                    </span>
                </div>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    bool loggedIn = false;
    string? username = "";
    protected override async Task OnAfterRenderAsync(bool firstRender) // OnAfterRenderAsync: kører efter komponenten er renderet af Blazor
    {
        if (firstRender) //Er true, når komponenten renderes første gang. Sikrer, at oplysningerne kun hentes én gang
        {
            loggedIn = await sessionStorage.GetItemAsync<bool>("userstatus");
            username = await sessionStorage.GetItemAsync<string>("username");
            StateHasChanged(); // Fortæller Blazor, at komponentens tilstand har ændret sig, og at den derfor skal renderes igen.
        }
    }
}